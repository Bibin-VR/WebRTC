# Database
DB_USER=webrtc
DB_PASSWORD=change_this_to_secure_password_min_32_chars
POSTGRES_INITDB_ARGS="-E UTF8"

# Redis
REDIS_PASSWORD=change_this_to_secure_password_min_32_chars

# JWT
JWT_SECRET=change_this_to_secure_secret_key_min_32_characters_long

# Domain
DOMAIN=yourdomain.com

# Backend
ENVIRONMENT=production
LOG_LEVEL=info

# Backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM UTC
